# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ── Deployer ─────────────────────────────────────────────────────────────────
# Private key of the deployer wallet (no 0x prefix, 64 hex characters).
# ⚠️  Keep this secret – anyone who has it controls your funds.
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── Wallet addresses for token allocation ────────────────────────────────────
# All three wallets can be the same address for testing purposes.
MARKETING_WALLET=0x...
TEAM_WALLET=0x...
LIQUIDITY_WALLET=0x...

# ── RPC endpoints ─────────────────────────────────────────────────────────────
# Recommended free providers:
#   • Alchemy  – https://dashboard.alchemy.com  (generous free tier)
#   • Infura   – https://infura.io              (100k req/day free)
#   • QuickNode – https://www.quicknode.com     (free trial)
#
# Sepolia RPC URL format:
#   Alchemy : https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
#   Infura  : https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# ── Block explorer ────────────────────────────────────────────────────────────
# Required for `npm run verify`.  Get a free key at https://etherscan.io/register
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# CoinMarketCap API key – used only for gas price reporting during tests.
# Get a free key at https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# ── How to get Sepolia ETH (free) ─────────────────────────────────────────────
# You need ~0.05–0.1 ETH for deployment + gas.
#   • https://sepoliafaucet.com              – 0.05 ETH, no sign-up
#   • https://faucets.chain.link/sepolia     – 0.1 ETH, requires LINK
#   • https://www.alchemy.com/faucets/ethereum-sepolia – requires Alchemy account
#
# ── Common issues ─────────────────────────────────────────────────────────────
# "Invalid private key"     → Ensure it is exactly 64 hex chars, no 0x prefix
# "Insufficient funds"      → Get more Sepolia ETH from a faucet above
# "Could not detect network"→ Check SEPOLIA_RPC_URL is correct and reachable
# "Contract not verified"   → Ensure ETHERSCAN_API_KEY is set correctly
