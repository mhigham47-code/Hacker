# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Private key of the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Wallet addresses for token allocation
MARKETING_WALLET=0x...
TEAM_WALLET=0x...
LIQUIDITY_WALLET=0x...

# RPC endpoints
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Block explorer API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinMarketCap API key (optional, used for gas price reporting)
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# Alpaca trading API (paper trading by default — see scripts/alpaca-buy.js
# and scripts/scalping-bot.js). Alpaca uses the same keys for stocks and crypto.
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Scalping bot tuning (all optional — see scripts/scalping-bot.js for defaults)
SCALPER_POSITION_USD=100
SCALPER_TAKE_PROFIT_PCT=0.006
SCALPER_STOP_LOSS_PCT=0.004
SCALPER_POLL_INTERVAL_MS=30000

# Must be explicitly "true" to let the scalping bot trade on a non-paper
# ALPACA_BASE_URL. Leave unset/false unless you deliberately intend to
# trade real money.
ALLOW_LIVE_TRADING=false
