# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Private key of the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Wallet addresses for token allocation
MARKETING_WALLET=0x...
TEAM_WALLET=0x...
LIQUIDITY_WALLET=0x...

# RPC endpoints (recommended providers: Alchemy, Infura, QuickNode, Ankr)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Block explorer API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinMarketCap API key (optional, used for gas price reporting)
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# Used by scripts/verify.js after deployment
DEPLOYED_ADDRESS=0x...
