# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Private key of the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Wallet addresses for token allocation
MARKETING_WALLET=0x...
TEAM_WALLET=0x...
LIQUIDITY_WALLET=0x...

# RPC endpoints
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Block explorer API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinMarketCap API key (optional, used for gas price reporting)
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# ── Post-deployment (fill in after deploying) ────────────────────────────────

# Deployed Hacker token address (output of deploy.js)
HACK_ADDRESS=0x...

# Uniswap V2 pair address (output of deployUniswapLP.js)
DEX_PAIR_ADDRESS=0x...

# ── Uniswap LP parameters ────────────────────────────────────────────────────

# Wrapped ETH on Sepolia (default already set in scripts, override if needed)
WETH_SEPOLIA=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9

# Uniswap V2 Router02 on Sepolia (default already set in scripts, override if needed)
UNISWAP_ROUTER=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008

# Amount of HACK tokens to add as liquidity (in full tokens, e.g. 500000000000 = 500B)
HACK_LIQUIDITY=500000000000

# Amount of ETH to pair with HACK liquidity
ETH_LIQUIDITY=0.5

